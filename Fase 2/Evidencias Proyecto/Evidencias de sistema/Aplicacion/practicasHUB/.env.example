# Copia este archivo como .env y completa los valores. .env NO se sube al repositorio.

# Firma de los tokens JWT (auth-service y api-gateway). Mínimo 32 caracteres.
JWT_SECRET=

# Clave compartida entre el api-gateway y los microservicios.
# Vacía = no se exige (desarrollo local). En Render es obligatoria (la genera render.yaml).
INTERNAL_SECRET=

# Clave para cifrar los mensajes entre docente y estudiante. Si se cambia, los mensajes
# antiguos ya no se pueden leer. Vacía = clave de desarrollo (solo local).
MESSAGE_KEY=

# Supabase
SUPABASE_PASSWORD=
SUPABASE_URL=https://<tu-proyecto>.supabase.co
# Clave service_role (Settings → API Keys → Legacy API Keys, empieza con eyJ)
SUPABASE_KEY=
SUPABASE_BUCKET=practicahub-files

# Correo con Brevo (notification-service). Vacío = los correos se muestran en la consola.
# API key: Brevo → SMTP & API → API Keys. EMAIL_FROM: un remitente verificado en Brevo.
BREVO_API_KEY=
EMAIL_FROM=

# Dirección del front: con ella se arma el enlace que recibe el supervisor (practice-service).
FRONTEND_URL=http://localhost:5173
