# Copia este archivo como .env y completa los valores. .env NO se sube al repositorio.

# Firma de los tokens JWT (auth-service y api-gateway). Mínimo 32 caracteres.
JWT_SECRET=

# Clave compartida entre el api-gateway y los microservicios.
# Vacía = no se exige (desarrollo local). En Render es obligatoria (la genera render.yaml).
INTERNAL_SECRET=

# Supabase
SUPABASE_PASSWORD=
SUPABASE_URL=https://<tu-proyecto>.supabase.co
# Clave service_role (Settings → API Keys → Legacy API Keys, empieza con eyJ)
SUPABASE_KEY=
SUPABASE_BUCKET=practicahub-files
