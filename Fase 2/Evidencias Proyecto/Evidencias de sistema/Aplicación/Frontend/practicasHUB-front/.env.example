# Configuración del frontend de PrácticasHub.
# Copia este archivo como `.env` y ajusta los valores. `.env` no se versiona.
#
# Aquí NO van secretos: todo lo que empieza por VITE_ queda incrustado en el bundle y es
# visible para cualquiera que abra el navegador. Claves, tokens y cadenas de conexión
# viven en el backend.

# Capa de datos.
#   true  -> almacén simulado en el navegador (services/mock). Único modo posible hoy:
#            el backend de Spring Boot todavía no existe.
#   false -> API REST real en VITE_API_URL.
#
# El mock no valida contraseñas ni autoriza nada. Nunca debe quedar en `true` en un
# entorno desplegado.
VITE_USAR_MOCKS=true

# URL base de la API REST. Solo se usa con VITE_USAR_MOCKS=false.
VITE_API_URL=http://localhost:8080/api
